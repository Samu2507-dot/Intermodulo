<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.cicd.controladores.PanelHuespedController">
    <stylesheets>
        <URL value="@decoracion.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 15 40; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
            <Label text="Roomly" style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #1E3A8A;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Cerrar Sesión" onAction="#handleCerrarSesion" styleClass="button-danger"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="15" style="-fx-padding: 20 60 20 60;">

                <Label fx:id="lblMensaje" style="-fx-text-fill: #059669; -fx-font-weight: bold;"/>

                <VBox spacing="5">
                    <Label text="Alojamientos Disponibles" styleClass="titulo-seccion"/>
                    <TableView fx:id="tablaAlojamientos" minHeight="300" prefHeight="300" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colFoto" text="Foto" prefWidth="100" />
                            <TableColumn fx:id="colNombreAlojamiento" text="Nombre" prefWidth="180" />
                            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="250" />
                            <TableColumn fx:id="colAnfitrion" text="Anfitrión" prefWidth="120" />
                        </columns>
                    </TableView>
                </VBox>

                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                    <Label text="Entrada:" style="-fx-text-fill: #4B5563;"/>
                    <DatePicker fx:id="dateInicio" prefWidth="120"/>
                    <Label text="Salida:" style="-fx-text-fill: #4B5563;"/>
                    <DatePicker fx:id="dateFin" prefWidth="120"/>
                    <Button text="Reservar" onAction="#handleReservar" styleClass="button-primary"/>
                </HBox>

                <VBox spacing="5">
                    <Label text="Tus reservas actuales" styleClass="titulo-seccion"/>
                    <TableView fx:id="tablaReservas" minHeight="150" prefHeight="150" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colAlojamiento" text="Alojamiento" prefWidth="325" />
                            <TableColumn fx:id="colFechas" text="Periodo" prefWidth="325" />
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>