<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dam.cicd.controladores.PanelMantenimientoController">
    <center>
        <VBox spacing="20" style="-fx-padding: 40;">

            <Label text="Incidencias Asignadas" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;"/>
            <TableView fx:id="tablaTareas" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="400" />
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="150" />
                </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="Marcar como Completado" onAction="#handleMarcarCompletado" styleClass="button-primary" style="-fx-background-color: #1E3A8A;"/>
                <Label fx:id="lblMensaje" style="-fx-text-fill: #059669; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>